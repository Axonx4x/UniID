# ==============================================================================
# AstraMind Digital Student ID - Environment Configuration
# Copy this file to .env for local development: cp .env.example .env
# Safe defaults are provided for local development. Never commit real secrets.
# ==============================================================================

# Application Environment (development, testing, staging, production)
ENVIRONMENT=development
PROJECT_NAME="AstraMind Digital Student ID"
API_V1_STR="/api/v1"
LOG_LEVEL=INFO

# Simulation Mode: explicitly marks integrations and data as synthetic/demo
SIMULATION_MODE=true
# Explicitly opt in to the persistent synthetic LUANAR presenter environment.
# Keep false for normal local development; this value is rejected in production.
UNIID_DEMO_MODE=false

# Local API Server Binding
API_HOST=0.0.0.0
API_PORT=8000

# Backend CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]'

# Database Configuration (PostgreSQL)
# Note: Local docker-compose maps external host port 5433 to container 5432 to avoid host collisions.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=astramind
POSTGRES_PASSWORD=astramind_dev_secret
POSTGRES_DB=astramind_digital_id

# Direct SQLAlchemy Database URL (psycopg 3 driver: postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://astramind:astramind_dev_secret@localhost:5433/astramind_digital_id

# Authentication. Replace with a randomly generated value of at least 32 characters outside local development.
SESSION_SECRET=development-only-session-secret-change-me
SESSION_COOKIE_NAME=astramind_session
SESSION_TTL_MINUTES=480
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Email OTP delivery. The bundled local default is an explicitly simulated
# mailbox; the frontend can display its code to speed up testing. Switch to
# smtp and fill the values below before any real-user deployment.
OTP_DELIVERY_MODE=development
OTP_DEV_MAILBOX_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="AstraMind Digital ID"
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Credential lifecycle demo default. Per-institution policies remain future work.
CREDENTIAL_VALIDITY_DAYS=365

# Public QR Verification Canonical Base URL (Must use HTTPS in production)
VERIFICATION_BASE_URL=http://localhost:5173/verify
VERIFICATION_RATE_LIMIT_ATTEMPTS=30
VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=60

# Frontend Vite Configuration (apps/web)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="AstraMind Digital ID"
VITE_SIMULATION_MODE=true
