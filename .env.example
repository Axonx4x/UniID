# ==============================================================================
# AstraMind Digital Student ID - Environment Configuration
# Copy this file to .env for local development: cp .env.example .env
# Safe defaults are provided for local development. Never commit real secrets.
# ==============================================================================

# Application Environment (development, testing, staging, production)
ENVIRONMENT=development
PROJECT_NAME="AstraMind Digital Student ID"
API_V1_STR="/api/v1"
LOG_LEVEL=INFO

# Simulation Mode: explicitly marks integrations and data as synthetic/demo
SIMULATION_MODE=true

# Local API Server Binding
API_HOST=0.0.0.0
API_PORT=8000

# Backend CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]'

# Database Configuration (PostgreSQL)
# Note: Local docker-compose maps external host port 5433 to container 5432 to avoid host collisions.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=astramind
POSTGRES_PASSWORD=astramind_dev_secret
POSTGRES_DB=astramind_digital_id

# Direct SQLAlchemy Database URL (psycopg 3 driver: postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://astramind:astramind_dev_secret@localhost:5433/astramind_digital_id

# Frontend Vite Configuration (apps/web)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="AstraMind Digital ID"
VITE_SIMULATION_MODE=true
